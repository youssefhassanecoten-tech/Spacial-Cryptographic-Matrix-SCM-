{
  "name": "scm-studio",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "1.6.0",
  "description": "Local-first 3D cryptographic matrix studio, sealed payload vault, and guest viewer",
  "author": "Youssef Hassan",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "build:electron": "cross-env VITE_BASE_PATH=./ VITE_PUBLIC_APP_URL=https://youssefhassanecoten-tech.github.io/Spacial-Cryptographic-Matrix-SCM-/ npm run build",
    "electron": "electron .",
    "dist:win": "npm run build:electron && electron-builder --win nsis portable",
    "dist:win:installer": "npm run build:electron && electron-builder --win nsis",
    "dist:mac": "npm run build:electron && electron-builder --mac dmg",
    "dist:linux": "npm run build:electron && electron-builder --linux AppImage",
    "cipher:test": "node --test scripts/scm-local-cipher.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.0",
    "@noble/hashes": "^1.8.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.67.0",
    "postprocessing": "^6.39.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.youssefhassan.scm",
    "productName": "SCM Studio",
    "copyright": "Copyright © 2026 Youssef Hassan",
    "directories": {
      "output": "release-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SCM-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SCM-Studio-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "youssefhassanecoten-tech",
        "repo": "Spacial-Cryptographic-Matrix-SCM-"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
